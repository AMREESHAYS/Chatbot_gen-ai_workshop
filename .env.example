# AI model configuration for Bella chatbot
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-4o-mini

# App config
APP_NAME=Amr Shop Bella
LOG_LEVEL=info
PORT=8000
USE_AI=true

# Optional chat behavior
RESPONSE_STYLE=warm friendly short responses
ORDER_CONFIRMATION_REQUIRED=true
MAX_INPUT_TOKENS=1024
